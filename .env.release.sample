# ЭТО ИНСТРУМЕНТ ДЛЯ РЕЛИЗА И ПОСТОВ ДЛЯ ТГ И ГИТА. НЕ НУЖЕН ДЛЯ РАБОТЫ ТГ БОТА! НЕ ЗАПОЛНЯЙТЕ ЕГО! ЭТО НУЖНО ТОЛЬКО ДЛЯ РАЗРАБОТКИ. 
# Локальные секреты для tools/release (скопируй в .env.release — не коммитить).
# go run ./tools/release preview|github|telegram|publish

# Bot token отдельного announce-бота (не TELEGRAM_TOKEN магазина).
RELEASE_TG_BOT_TOKEN=

# Прокси до api.telegram.org (если Clash/VPN даёт fake-IP 198.18.*).
# Пример FlClash/Clash: http://127.0.0.1:7890  или socks5://127.0.0.1:7891
# Если прокси не поднят, утилита сама повторит отправку напрямую — так релиз
# не срывается из-за выключенного Clash. Повтор делается только когда запрос
# заведомо не дошёл до Telegram, иначе анонс мог бы уйти в канал дважды.
RELEASE_TG_PROXY_URL=

# Chat id супергруппы/канала: @username или числовой -100…
RELEASE_TG_CHAT_ID=@meows_vpn_bot

# Id темы форума (для https://t.me/meows_vpn_bot/31 — это 31).
RELEASE_TG_MESSAGE_THREAD_ID=31

# Подпись в конце TG-поста (кликабельная).
RELEASE_TG_FOOTER_TEXT=Meows VPN Group
RELEASE_TG_FOOTER_URL=https://t.me/meows_vpn_bot
# Custom emoji перед подписью (HTML <tg-emoji>). Нужен бот с Fragment username.
RELEASE_TG_FOOTER_CUSTOM_EMOJI_ID=5451703345746058024
# Fallback-юникод, если custom emoji недоступен (обязателен API).
RELEASE_TG_FOOTER_CUSTOM_EMOJI_ALT=✨

# Опционально: owner/repo для gh release create --repo
RELEASE_GITHUB_REPO=MrMe0ws/remnawave-telegram-shop

# Опционально: путь к RELEASE_NOTES.md (по умолчанию ./RELEASE_NOTES.md)
# RELEASE_NOTES_PATH=RELEASE_NOTES.md
